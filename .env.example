# Copie para .env (ignorado pelo git). Nunca commite senhas reais.
# Padrão (omitido): SQLite em data/app.db.
# Postgres local (docker compose up -d db). Escolha a senha e use a mesma nas URLs:
POSTGRES_PASSWORD=<escolha-uma-senha>
# Senha do role só-leitura que a API usa (database/readonly_role.sql). Outra senha, diferente da acima.
READONLY_POSTGRES_PASSWORD=<escolha-outra-senha>
# DATABASE_URL=postgresql+psycopg://finance:<senha>@127.0.0.1:5433/finance
#
# Testes contra Postgres (a suíte apaga e recria as tabelas deste banco!):
# TEST_DATABASE_URL=postgresql+psycopg://finance:<senha>@127.0.0.1:5433/finance_test
