  "paths": {
    "/calcular/{metodo}": {
      "post": {
        "description": "Calcula preço teto com base em um modelo e suas premissas",
        "operationId": "calcular_calcular__metodo__post",
        "parameters": [
          {
            "in": "path",
            "name": "metodo",
            "required": true,
            "schema": {
              "title": "Metodo",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "title": "Premissas",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoCalculo"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Calcular"
      }
    },
